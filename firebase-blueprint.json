{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile, preferences, and localization settings.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "photoURL": {
          "type": "string",
          "maxLength": 200000
        },
        "bio": {
          "type": "string",
          "maxLength": 240
        },
        "language": {
          "type": "string",
          "enum": ["en", "bn"]
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark"]
        },
        "onboarded": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "language", "theme", "onboarded", "createdAt", "updatedAt"]
    },
    "Task": {
      "title": "Task",
      "description": "A user daily task with subtasks, timer tracking, recurrence, and attachments.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "categoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "projectId": {
          "type": "string",
          "maxLength": 64
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "urgent"]
        },
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "completed", "cancelled"]
        },
        "startAt": {
          "type": "string",
          "format": "date-time"
        },
        "dueAt": {
          "type": "string",
          "format": "date-time"
        },
        "reminderAt": {
          "type": "string",
          "format": "date-time"
        },
        "estimatedMinutes": {
          "type": "number"
        },
        "actualMinutes": {
          "type": "number"
        },
        "timerStartedAt": {
          "type": "number"
        },
        "subtasks": {
          "type": "array"
        },
        "tags": {
          "type": "array"
        },
        "attachments": {
          "type": "array"
        },
        "repeatRule": {
          "type": "string",
          "enum": ["none", "daily", "weekly", "monthly"]
        },
        "recurrenceSeriesId": {
          "type": "string",
          "maxLength": 128
        },
        "isArchived": {
          "type": "boolean"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "description",
        "categoryId",
        "priority",
        "status",
        "estimatedMinutes",
        "actualMinutes",
        "subtasks",
        "tags",
        "attachments",
        "repeatRule",
        "isArchived",
        "createdAt",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "User-scoped task category with custom color and icon.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "color": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "isDefault": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "name", "color", "icon", "isDefault", "createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "User project grouping related tasks.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "color": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "isArchived": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "name", "description", "color", "icon", "isArchived", "createdAt", "updatedAt"]
    },
    "NotificationPreferences": {
      "title": "NotificationPreferences",
      "description": "Reminder, quiet hours, and summary alert settings for a user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dueReminders": { "type": "boolean" },
        "upcomingAlerts": { "type": "boolean" },
        "overdueAlerts": { "type": "boolean" },
        "dailySummary": { "type": "boolean" },
        "morningBrief": { "type": "boolean" },
        "morningTime": {
          "type": "string",
          "minLength": 4,
          "maxLength": 10
        },
        "quietHoursEnabled": { "type": "boolean" },
        "quietStart": {
          "type": "string",
          "minLength": 4,
          "maxLength": 10
        },
        "quietEnd": {
          "type": "string",
          "minLength": 4,
          "maxLength": 10
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "dueReminders",
        "upcomingAlerts",
        "overdueAlerts",
        "dailySummary",
        "morningBrief",
        "morningTime",
        "quietHoursEnabled",
        "quietStart",
        "quietEnd",
        "updatedAt"
      ]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "Notification history item for reminders, overdue alerts, and summaries.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "taskId": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "body": {
          "type": "string",
          "maxLength": 400
        },
        "type": {
          "type": "string",
          "enum": ["due", "upcoming", "overdue", "summary", "system"]
        },
        "isRead": { "type": "boolean" },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "taskId", "title", "body", "type", "isRead", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and preferences scoped strictly to the owning user."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "User's private tasks with subtasks, timer state, attachments, and recurrence metadata."
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "User's custom and default task categories."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "User's projects for organizing tasks."
    },
    "/users/{userId}/notificationPreferences/{prefId}": {
      "schema": { "$ref": "#/entities/NotificationPreferences" },
      "description": "User's reminder and quiet-hours notification settings."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AppNotification" },
      "description": "User's in-app notification history and reminder delivery log."
    }
  }
}
